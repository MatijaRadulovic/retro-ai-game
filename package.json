{
  "name": "retro-snake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal retro-inspired Snake browser game.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && node --test tests/*.test.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
